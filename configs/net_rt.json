  "features": [
    "network_accept_count",
    "network_close_count",
    "network_connection_count",
    "network_connection_rate",
    "network_error_count",
    "network_event_count",
    "network_interarrival_max_seconds",
    "network_interarrival_mean_seconds",
    "network_interarrival_min_seconds",
    "network_interarrival_std_seconds",
    "network_unique_destination_ips",
    "network_unique_source_ips",
    "network_unique_source_ports",
    "runtime_error_count",
    "runtime_event_count",
    "runtime_exec_rate",
    "runtime_interactive_shell_count",
    "runtime_non_root_exec_count",
    "runtime_root_exec_count",
    "runtime_sensitive_command_count",
    "runtime_unique_commands",
