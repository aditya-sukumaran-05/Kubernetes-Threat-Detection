# Byte-compiled / cache / temporary files
__pycache__/
*.py[cod]
*$py.class
*.bak

# Testing and linting caches
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/

# Model files
*.joblib

# External datasets
external_data/

# Local collector runtime state / PID files
*.pid
.*.pid
telemetry/data/.*.pid
telemetry/data/*/.runtime_collector.pid
telemetry/data/.workload_collector.pid
telemetry/data/.network_collector.pid

# Streamlit secrets
.streamlit/secrets.toml

# Diary and capstone submission documents (personal, not project code)
SWE3004_*.docx
SWE3004_*.csv

# Launcher PID file
.launcher_pids

# Collector runtime logs
telemetry/data/*_collector.log
telemetry/data/*.log